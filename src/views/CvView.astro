---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/layout/CTASection.astro';
import { getProfile, getExperienceForCv, getTechStackByCategory, formatMonth } from '@lib/content';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const [profile, entries, skillGroups] = await Promise.all([
  getProfile(lang),
  getExperienceForCv(lang),
  getTechStackByCategory(lang),
]);
const { name, title, cvTitle, cvSummary, bio, email, linkedin, github, location, education, languages, certifications } = profile;

const summaryParagraphs = (cvSummary ?? bio ?? '').split('\n\n').map((p) => p.trim()).filter(Boolean);
const bySection = (section: string) => entries.filter((e) => e.section === section);
const thesis = bySection('education');
const experience = bySection('experience');
const appliedAi = bySection('ai');
const projects = bySection('projects');

/** Human-readable span for an entry; empty when nothing is known. */
function period(exp: { startDate?: string; endDate?: string; duration?: string }) {
  if (exp.startDate) {
    const end = exp.endDate ? formatMonth(exp.endDate, lang) : t('cv.present');
    return `${formatMonth(exp.startDate, lang)} – ${end}`;
  }
  return exp.duration ?? '';
}

const description = t('meta.cvDescription').replace('{name}', name).replace('{title}', title);
const sections = [
  { id: 'cv-edu', heading: t('cv.education'), items: thesis, extra: education },
  { id: 'cv-exp', heading: t('cv.experience'), items: experience, extra: [] as string[] },
  { id: 'cv-ai', heading: t('cv.ai'), items: appliedAi, extra: [] as string[] },
  { id: 'cv-projects', heading: t('cv.projects'), items: projects, extra: [] as string[] },
];
---
<BaseLayout title={`${t('meta.cvTitle')} | ${name}`} description={description} route={{ name: 'cv' }}>
  <div class="cv-screen">
    <div class="cv-toolbar">
      <button type="button" id="cv-download" class="cv-download">{t('cv.download')}</button>
    </div>

    <article class="cv-sheet" aria-labelledby="cv-title">
      <header class="cv-header">
        <h1 id="cv-title">{name}</h1>
        <p class="cv-role">{cvTitle}</p>
        <p class="cv-contact">
          {[
            location && <span>{location}</span>,
            <a href={`mailto:${email}`}>{email}</a>,
            linkedin && <a href={linkedin}>LinkedIn</a>,
            github && <a href={github}>GitHub</a>,
          ].filter(Boolean).map((node, i) => <Fragment>{i > 0 && ' · '}{node}</Fragment>)}
        </p>
      </header>

      {summaryParagraphs.length > 0 && (
        <section aria-labelledby="cv-summary" class="cv-summary">
          <h2 id="cv-summary">{t('cv.summary')}</h2>
          {summaryParagraphs.map((p) => <p>{p}</p>)}
        </section>
      )}

      {sections.map(({ id, heading, items, extra }) => (items.length > 0 || extra.length > 0) && (
        <section aria-labelledby={id}>
          <h2 id={id}>{heading}</h2>
          {extra.map((item) => <p class="cv-line">{item}</p>)}
          {items.map((exp) => {
            const when = period(exp);
            // Thesis leads with its title; jobs lead with the organization.
            const roleFirst = exp.section === 'education' || !exp.company;
            const org = roleFirst ? exp.role : exp.company;
            const sub = [roleFirst ? exp.company : exp.role, exp.location].filter(Boolean).join(' · ');
            return (
              <div class="cv-entry">
                <div class="cv-row">
                  <strong>{org}</strong>
                  {when && <span class="cv-date">{when}</span>}
                </div>
                {sub && <p class="cv-sub">{sub}</p>}
                {exp.description && <p class="cv-desc">{exp.description}</p>}
                {exp.highlights.length > 0 && (
                  <ul>{exp.highlights.map((h) => <li>{h}</li>)}</ul>
                )}
                {exp.stack.length > 0 && (
                  <p class="cv-sub cv-tech">{t('cv.technologies')}: {exp.stack.join(', ')}</p>
                )}
              </div>
            );
          })}
        </section>
      ))}

      {skillGroups.length > 0 && (
        <section aria-labelledby="cv-skills">
          <h2 id="cv-skills">{t('cv.skills')}</h2>
          {skillGroups.map((g) => <p class="cv-skill"><strong>{g.category}:</strong> {g.skills.join(', ')}</p>)}
        </section>
      )}

      {certifications.length > 0 && (
        <section aria-labelledby="cv-certs">
          <h2 id="cv-certs">{t('cv.certifications')}</h2>
          <ul class="cv-plain">
            {certifications.map((c) => (
              <li class="cv-row">
                <span>{c.name}{c.issuer && ` — ${c.issuer}`}</span>
                {c.year && <span class="cv-date">{c.year}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {languages.length > 0 && (
        <section aria-labelledby="cv-langs">
          <h2 id="cv-langs">{t('cv.languages')}</h2>
          <p>{languages.map((l) => `${l.name} (${l.level})`).join(', ')}</p>
        </section>
      )}
    </article>
  </div>

  <div class="cv-cta"><CTASection /></div>
</BaseLayout>

<script is:inline>
  document.getElementById('cv-download')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  .cv-screen { padding: 2rem 1rem 3rem; }
  .cv-toolbar { max-width: 8.5in; margin: 0 auto 1rem; display: flex; justify-content: flex-end; }
  .cv-download {
    cursor: pointer; border-radius: 0.5rem; padding: 0.6rem 1.1rem; font-weight: 600; font-size: 0.95rem;
    background: #1f5c52; color: #fff; border: 0;
  }
  .cv-download:hover { opacity: 0.9; }
  .cv-sheet {
    max-width: 8.5in; margin: 0 auto; box-sizing: border-box;
    padding: 0.5in 0.6in; background: #fff; color: #000;
    font-family: Georgia, 'Times New Roman', Times, serif; font-size: 10pt; line-height: 1.25;
    box-shadow: 0 4px 24px rgb(0 0 0 / 0.18);
  }
  .cv-sheet a { color: inherit; text-decoration: none; }
  .cv-sheet .cv-summary p + p { margin-top: 4pt; }
  .cv-sheet .cv-role { text-align: center; font-size: 10.5pt; font-weight: 600; margin: 3pt 0 2pt; }
  .cv-sheet h1 { font: inherit; font-size: 20pt; font-weight: 700; text-align: center; margin: 0; letter-spacing: 0.02em; }
  .cv-sheet h2 {
    font: inherit; font-size: 10pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
    border-bottom: 1px solid #000; padding-bottom: 1px; margin: 9pt 0 4pt; break-after: avoid;
  }
  .cv-sheet p, .cv-sheet ul { margin: 0; }
  .cv-sheet .cv-contact { text-align: center; font-size: 9.5pt; margin-top: 4pt; }
  .cv-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
  .cv-date { white-space: nowrap; }
  .cv-sub { font-style: italic; }
  .cv-sheet .cv-desc { margin-top: 2pt; }
  .cv-entry { margin-bottom: 5pt; break-inside: avoid; }
  .cv-sheet ul { list-style: disc; padding-left: 1.2em; margin-top: 2pt; }
  .cv-sheet ul.cv-plain { list-style: none; padding: 0; }
  .cv-sheet li { margin: 1pt 0; }
  .cv-sheet .cv-line, .cv-sheet .cv-skill { margin-bottom: 3pt; }
  .cv-sheet .cv-tech { margin-top: 3pt; }

  @page { size: Letter; margin: 0.5in; }
  @media print {
    html, body { background: #fff !important; }
    body > header, body > footer, body > a, .cv-toolbar, .cv-cta { display: none !important; }
    .cv-screen { padding: 0; }
    .cv-sheet { box-shadow: none; margin: 0; max-width: none; padding: 0; }
  }
</style>
