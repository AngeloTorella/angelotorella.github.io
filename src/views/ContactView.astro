---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Button from '@components/ui/Button.astro';
import SocialLinks from '@components/ui/SocialLinks.astro';
import { getProfile, getServices } from '@lib/content';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const [{ name, email, linkedin, github, calendarUrl }, services] = await Promise.all([getProfile(lang), getServices(lang)]);
// Formspree-compatible endpoint. When unset, the page falls back to a mailto card.
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT?.trim();
const mailto = `mailto:${email}?subject=${encodeURIComponent(t('contact.mailSubject'))}`;

const inputClass =
  'w-full rounded-lg border border-line bg-paper px-4 py-2.5 text-ink placeholder:text-muted/70 focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/30';
const labelClass = 'mb-1.5 block text-sm font-medium';
const steps = [t('contact.next1'), t('contact.next2'), t('contact.next3')];
---
<BaseLayout title={`${t('meta.contactTitle')} | ${name}`} description={t('meta.contactDescription')} route={{ name: 'contact' }}>
  <Section class="pb-12 md:pb-16" labelledby="contact-title">
    <header class="max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">{t('contact.eyebrow')}</p>
      <h1 id="contact-title" class="font-display text-4xl font-semibold leading-tight tracking-tight md:text-5xl">{t('contact.title')}</h1>
      <p class="mt-5 text-lg text-muted">
        {t('contact.intro')}
      </p>
    </header>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.4fr_1fr] lg:gap-14">
      <div>
        {formEndpoint ? (
          <form id="contact-form" class="relative overflow-hidden rounded-2xl border border-line bg-surface p-6 shadow-card sm:p-8" action={formEndpoint} method="POST">
            <!-- Honeypot: real users leave it empty; Formspree discards submissions that fill it. -->
            <div class="absolute -left-[9999px]" aria-hidden="true">
              <label for="_gotcha">{t('contact.honeypot')}</label>
              <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class={labelClass}>{t('contact.name')} <span aria-hidden="true">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" class={inputClass} placeholder={t('contact.namePlaceholder')} />
              </div>
              <div>
                <label for="email" class={labelClass}>{t('contact.email')} <span aria-hidden="true">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" class={inputClass} placeholder={t('contact.emailPlaceholder')} />
              </div>
              <div>
                <label for="company" class={labelClass}>{t('contact.company')}</label>
                <input type="text" id="company" name="company" autocomplete="organization" class={inputClass} placeholder={t('contact.companyPlaceholder')} />
              </div>
              <div>
                <label for="service" class={labelClass}>{t('contact.service')}</label>
                <select id="service" name="service" class={inputClass}>
                  <option value="">{t('contact.serviceUnknown')}</option>
                  {services.map(service => <option value={service.slug}>{service.data.title}</option>)}
                </select>
              </div>
            </div>

            <div class="mt-5">
              <label for="message" class={labelClass}>{t('contact.message')} <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" required rows="5" class={inputClass} placeholder={t('contact.messagePlaceholder')}></textarea>
            </div>

            <Button type="submit" size="lg" class="mt-6 w-full sm:w-auto" arrow>{t('contact.send')}</Button>
          </form>
        ) : (
          <div class="rounded-2xl border border-line bg-surface p-6 shadow-card sm:p-8">
            <p class="text-sm font-semibold uppercase tracking-widest text-muted">{t('contact.writeTo')}</p>
            <p class="mt-3 break-all font-display text-2xl font-semibold text-ink select-all sm:text-3xl" id="email-text">{email}</p>
            <p class="mt-3 text-muted">{t('contact.writeToText')}</p>
            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
              <Button href={mailto} size="lg" arrow>{t('contact.sendEmail')}</Button>
              <button type="button" id="copy-email" data-email={email} data-copied={t('contact.copied')} data-failed={t('contact.copyFailed')} class="group inline-flex items-center justify-center gap-2 rounded-lg border border-ink/25 px-6 py-3.5 text-base font-semibold text-ink transition-colors hover:border-brand hover:text-brand">
                {t('contact.copy')}
              </button>
            </div>
            <p id="copy-status" class="mt-3 min-h-[1.25rem] text-sm text-brand" role="status" aria-live="polite"></p>
          </div>
        )}
      </div>

      <aside class="space-y-8">
        <div>
          <h2 class="font-display text-xl font-semibold">{t('contact.nextTitle')}</h2>
          <ol class="mt-4 space-y-4">
            {steps.map((step, i) => (
              <li class="flex gap-4">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-soft text-sm font-semibold text-brand" aria-hidden="true">{i + 1}</span>
                <span class="text-muted">{step}</span>
              </li>
            ))}
          </ol>
        </div>

        {(formEndpoint || linkedin || github || calendarUrl) && (
          <div class="border-t border-line pt-6">
            <h2 class="font-display text-xl font-semibold">{t('contact.otherWays')}</h2>
            {formEndpoint && <p class="mt-4"><a href={mailto} class="font-medium text-brand underline underline-offset-4">{email}</a></p>}
            <SocialLinks labels class="-ml-2 mt-2 flex-wrap" />
            {calendarUrl && <p class="mt-2"><a href={calendarUrl} target="_blank" rel="noopener noreferrer" class="font-medium text-brand underline underline-offset-4">{t('contact.bookCall')}</a></p>}
          </div>
        )}
      </aside>
    </div>
  </Section>

  {formEndpoint ? (
    <script is:inline>
      // Pre-select the service passed as ?service=<id> (e.g. from a service page CTA).
      (function () {
        var id = new URLSearchParams(location.search).get('service');
        var select = document.getElementById('service');
        if (id && select && select.querySelector('option[value="' + CSS.escape(id) + '"]')) select.value = id;
      })();
    </script>
  ) : (
    <script is:inline>
      // Copy the email address to the clipboard, with a text fallback for older browsers.
      (function () {
        var btn = document.getElementById('copy-email');
        var status = document.getElementById('copy-status');
        if (!btn || !status) return;
        function done(ok) {
          status.textContent = ok ? btn.getAttribute('data-copied') : btn.getAttribute('data-failed');
          setTimeout(function () { status.textContent = ''; }, 3500);
        }
        btn.addEventListener('click', function () {
          var email = btn.getAttribute('data-email');
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(email).then(function () { done(true); }, function () { done(false); });
            return;
          }
          var node = document.getElementById('email-text');
          var range = document.createRange();
          range.selectNodeContents(node);
          var sel = window.getSelection();
          sel.removeAllRanges();
          sel.addRange(range);
          done(document.execCommand && document.execCommand('copy'));
        });
      })();
    </script>
  )}
</BaseLayout>
