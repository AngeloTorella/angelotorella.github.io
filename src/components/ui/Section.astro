---
interface Props {
  id?: string;
  tone?: 'paper' | 'sunken';
  class?: string;
  labelledby?: string;
}
const { id, tone = 'paper', class: className = '', labelledby } = Astro.props;
const tones = { paper: 'bg-paper', sunken: 'bg-sunken' };
---
<section id={id} aria-labelledby={labelledby} class={`py-16 md:py-24 ${tones[tone]} ${className}`}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <slot />
  </div>
</section>
