---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'inverse';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  class?: string;
  arrow?: boolean;
}
const { href, variant = 'primary', size = 'md', type = 'button', class: className = '', arrow = false } = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-lg font-semibold transition-colors duration-200 disabled:opacity-50';
const variants = {
  primary: 'bg-brand text-on-brand shadow-sm hover:bg-brand-strong',
  secondary: 'border border-ink/25 bg-transparent text-ink hover:border-brand hover:text-brand',
  inverse: 'bg-band-fg text-band hover:bg-white',
};
const sizes = { md: 'px-5 py-2.5 text-sm', lg: 'px-6 py-3.5 text-base' };
const classes = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---
{href ? (
  <a href={href} class={classes}>
    <slot />
    {arrow && <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5">→</span>}
  </a>
) : (
  <button type={type} class={classes}>
    <slot />
    {arrow && <span aria-hidden="true">→</span>}
  </button>
)}
