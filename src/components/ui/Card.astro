---
interface Props {
  class?: string;
  hover?: boolean;
}
const { class: className = '', hover = true } = Astro.props;
---
<div class={`rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow dark:border-gray-700 dark:bg-gray-900 ${hover ? 'hover:shadow-md' : ''} ${className}`}>
  <slot />
</div>