---
import SocialLinks from '@components/ui/SocialLinks.astro';
import { getProfile, getServices } from '@lib/content';

const [{ name, title, email, location }, services] = await Promise.all([getProfile(), getServices()]);
const linkClass = 'text-muted transition-colors hover:text-brand';
---
<footer class="border-t border-line bg-sunken">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-xl font-semibold">{name}</p>
        <p class="mt-1 text-sm text-muted">{title}</p>
        {location && <p class="mt-1 text-sm text-muted">{location}</p>}
        <a href={`mailto:${email}`} class="mt-5 inline-block break-all text-base font-medium text-brand underline underline-offset-4 hover:text-brand-strong">{email}</a>
        <SocialLinks labels class="-ml-2 mt-3 flex-wrap" />
      </div>

      <nav aria-label="Servicios">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-ink">Servicios</h2>
        <ul class="space-y-2 text-sm">
          {services.map(service => (
            <li><a href={`/services/${service.id}`} class={linkClass}>{service.data.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Más enlaces">
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-ink">Más</h2>
        <ul class="space-y-2 text-sm">
          <li><a href="/#proceso" class={linkClass}>Cómo trabajo</a></li>
          <li><a href="/contacto" class={linkClass}>Contacto</a></li>
        </ul>
      </nav>
    </div>

    <p class="mt-12 border-t border-line pt-6 text-sm text-muted">© {new Date().getFullYear()} {name}. Todos los derechos reservados.</p>
  </div>
</footer>
