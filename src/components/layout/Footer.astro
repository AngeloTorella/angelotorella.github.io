---
import SocialLinks from '@components/ui/SocialLinks.astro';
import { getProfile, getServices } from '@lib/content';
import { getLangFromUrl, routePath, sectionPath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const [{ name, title, email, location }, services] = await Promise.all([getProfile(lang), getServices(lang)]);
const linkClass = 'text-muted transition-colors hover:text-brand';
---
<footer class="border-t border-line bg-sunken">
  <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-xl font-semibold">{name}</p>
        <p class="mt-1 text-sm text-muted">{title}</p>
        {location && <p class="mt-1 text-sm text-muted">{location}</p>}
        <a href={`mailto:${email}`} class="mt-5 inline-block break-all text-base font-medium text-brand underline underline-offset-4 hover:text-brand-strong">{email}</a>
        <SocialLinks labels class="-ml-2 mt-3 flex-wrap" />
      </div>

      <nav aria-label={t('footer.services')}>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-ink">{t('footer.services')}</h2>
        <ul class="space-y-2 text-sm">
          {services.map(service => (
            <li><a href={routePath({ name: 'service', slug: service.slug }, lang)} class={linkClass}>{service.data.title}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label={t('footer.moreNav')}>
        <h2 class="mb-3 text-sm font-semibold uppercase tracking-wider text-ink">{t('footer.more')}</h2>
        <ul class="space-y-2 text-sm">
          <li><a href={sectionPath('proceso', lang)} class={linkClass}>{t('footer.process')}</a></li>
          <li><a href={routePath({ name: 'contact' }, lang)} class={linkClass}>{t('footer.contact')}</a></li>
        </ul>
      </nav>
    </div>

    <p class="mt-12 border-t border-line pt-6 text-sm text-muted">© {new Date().getFullYear()} {name}. {t('footer.rights')}</p>
  </div>
</footer>
