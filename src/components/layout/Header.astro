---
import Button from '@components/ui/Button.astro';
import SocialLinks from '@components/ui/SocialLinks.astro';
import { getProfile, getCaseStudies } from '@lib/content';

const [{ name }, caseStudies] = await Promise.all([getProfile(), getCaseStudies()]);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/#servicios', label: 'Servicios', current: path.startsWith('/services') },
  { href: '/#proceso', label: 'Cómo trabajo', current: false },
  ...(caseStudies.length > 0 ? [{ href: '/#casos', label: 'Casos', current: false }] : []),
  { href: '/cv', label: 'CV', current: path === '/cv' },
];
const contactCurrent = path === '/contacto';
const initials = name
  .split(' ')
  .map(part => part[0])
  .slice(0, 2)
  .join('');

const linkBase = 'rounded-md px-3 py-2 text-sm font-medium transition-colors hover:text-brand';
---
<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/75">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8" aria-label="Principal">
    <a href="/" class="flex items-center gap-2.5" aria-label={`${name}, inicio`}>
      <span aria-hidden="true" class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand font-display text-sm font-semibold text-on-brand">{initials}</span>
      <span class="font-display text-lg font-semibold tracking-tight">{name}</span>
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {links.map(link => (
        <a href={link.href} class={`${linkBase} ${link.current ? 'text-brand' : 'text-muted'}`} aria-current={link.current ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <SocialLinks class="ml-2" />
      <Button href="/contacto" class={`ml-2 ${contactCurrent ? 'ring-2 ring-brand/40 ring-offset-2 ring-offset-paper' : ''}`}>Hablemos</Button>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-line text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
        <path id="icon-open" d="M4 7h16M4 12h16M4 17h16" />
        <path id="icon-close" class="hidden" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-paper md:hidden">
    <div class="mx-auto flex max-w-6xl flex-col gap-1 px-5 py-4 sm:px-8">
      {links.map(link => (
        <a href={link.href} class={`rounded-lg px-3 py-3 text-base font-medium ${link.current ? 'bg-brand-soft text-brand' : 'text-ink'}`} aria-current={link.current ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <SocialLinks labels class="mt-1" />
      <Button href="/contacto" size="lg" class="mt-2 w-full">Hablemos de tu proyecto</Button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var toggle = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!toggle || !menu) return;
    var iconOpen = document.getElementById('icon-open');
    var iconClose = document.getElementById('icon-close');

    function setOpen(open) {
      menu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    }

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });
    // Close after choosing a link or pressing Escape.
    menu.addEventListener('click', function (e) {
      if (e.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>
