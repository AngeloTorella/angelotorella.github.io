---
import Button from '@components/ui/Button.astro';
import { getProfile } from '@lib/content';

interface Props {
  title?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
}
const {
  title = '¿Hablamos de tu proyecto?',
  description = 'Cuéntame qué necesitas. Te respondo con los próximos pasos y, si no soy la persona indicada, te lo diré con sinceridad.',
  ctaText = 'Hablemos de tu proyecto',
  ctaHref = '/contacto',
} = Astro.props;
const { email } = await getProfile();
---
<section class="on-band bg-band py-16 text-band-fg md:py-20" aria-labelledby="cta-title">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-5 sm:px-8 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <h2 id="cta-title" class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-band-fg/85">{description}</p>
    </div>
    <div class="flex flex-col items-start gap-3">
      <Button href={ctaHref} variant="inverse" size="lg" arrow>{ctaText}</Button>
      <a href={`mailto:${email}`} class="break-all text-sm text-band-fg/85 underline underline-offset-4 hover:text-band-fg">o escribe a {email}</a>
    </div>
  </div>
</section>
