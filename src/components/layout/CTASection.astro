---
import Button from '@components/ui/Button.astro';
import { getProfile } from '@lib/content';
import { getLangFromUrl, routePath, useTranslations } from '@/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const {
  title = t('cta.title'),
  description = t('cta.description'),
  ctaText = t('cta.button'),
  ctaHref = routePath({ name: 'contact' }, lang),
} = Astro.props;
const { email } = await getProfile(lang);
---
<section class="on-band bg-band py-16 text-band-fg md:py-20" aria-labelledby="cta-title">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-8 px-5 sm:px-8 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <h2 id="cta-title" class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-band-fg/85">{description}</p>
    </div>
    <div class="flex flex-col items-start gap-3">
      <Button href={ctaHref} variant="inverse" size="lg" arrow>{ctaText}</Button>
      <a href={`mailto:${email}`} class="break-all text-sm text-band-fg/85 underline underline-offset-4 hover:text-band-fg">{t('cta.orWrite')} {email}</a>
    </div>
  </div>
</section>
