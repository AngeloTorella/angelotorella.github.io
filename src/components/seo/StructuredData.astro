---
// Schema.org JSON-LD describing the person and the services offered, for search and AI engines.
import { getProfile, getServices } from '@lib/content';
import { getLangFromUrl, routePath, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const [profile, services] = await Promise.all([getProfile(lang), getServices(lang)]);
const origin = Astro.site?.toString() ?? '/';
// Home page of the current language.
const site = new URL(routePath({ name: 'home' }, lang), origin).toString();
const [city, country] = (profile.location ?? '').split(',').map((part) => part.trim());
const sameAs = [profile.linkedin, profile.github].filter(Boolean);

const person = {
  '@type': 'Person',
  '@id': `${site}#person`,
  name: profile.name,
  jobTitle: profile.title,
  email: `mailto:${profile.email}`,
  url: site,
  image: new URL('/icon-512.png', origin).toString(),
  sameAs,
  ...(city && {
    address: { '@type': 'PostalAddress', addressLocality: city, addressCountry: country ?? city },
  }),
};

const business = {
  '@type': 'ProfessionalService',
  '@id': `${site}#business`,
  name: `${profile.name} | ${t('seo.businessSuffix')}`,
  inLanguage: lang,
  description: profile.tagline,
  url: site,
  email: profile.email,
  image: new URL('/og-image.png', origin).toString(),
  founder: { '@id': `${site}#person` },
  ...(city && { address: person.address }),
  areaServed: [
    ...(city ? [{ '@type': 'City', name: city }] : []),
    ...(country ? [{ '@type': 'Country', name: country }] : []),
    t('seo.remote'),
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: t('seo.catalogName'),
    itemListElement: services.map(({ slug, data }) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: data.title,
        description: data.tagline,
        url: new URL(routePath({ name: 'service', slug }, lang), origin).toString(),
      },
    })),
  },
};

const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [person, business] });
---
<script type="application/ld+json" set:html={jsonLd} />
