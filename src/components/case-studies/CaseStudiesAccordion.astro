---
import type { CollectionEntry } from 'astro:content';

interface Props {
  caseStudies: CollectionEntry<'caseStudies'>[];
  title?: string;
}
const { caseStudies, title = 'Casos de éxito' } = Astro.props;
---
<section id="casos" class="py-16 md:py-24 bg-gray-50 dark:bg-gray-900">
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-12 max-w-3xl mx-auto text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">{title}</h2>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Proyectos en los que he trabajado: el reto, la solución y el resultado.
      </p>
    </div>
    <div class="space-y-6">
      {caseStudies.map(({ data: study }) => (
        <details class="group rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg dark:border-gray-700 dark:bg-gray-900">
          <summary class="flex cursor-pointer items-center justify-between list-none">
            <div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white group-open:text-primary-600 dark:group-open:text-primary-400 transition-colors">{study.title}</h3>
              {study.client && <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{study.client}</p>}
            </div>
            <svg class="h-5 w-5 text-gray-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-6 space-y-6 pt-6 border-t border-gray-100 dark:border-gray-800">
            {study.challenge && (
              <div>
                <h4 class="mb-2 font-medium text-gray-900 dark:text-white">Reto</h4>
                <p class="text-gray-600 dark:text-gray-300">{study.challenge}</p>
              </div>
            )}
            {study.solution && (
              <div>
                <h4 class="mb-2 font-medium text-gray-900 dark:text-white">Solución</h4>
                <p class="text-gray-600 dark:text-gray-300">{study.solution}</p>
              </div>
            )}
            {study.results && (
              <div>
                <h4 class="mb-2 font-medium text-gray-900 dark:text-white">Resultados</h4>
                <p class="text-gray-600 dark:text-gray-300">{study.results}</p>
              </div>
            )}
            {study.stack.length > 0 && (
              <div>
                <h4 class="mb-2 font-medium text-gray-900 dark:text-white">Stack</h4>
                <div class="flex flex-wrap gap-2">
                  {study.stack.map(tech => (
                    <span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">{tech}</span>
                  ))}
                </div>
              </div>
            )}
            {study.artifacts.length > 0 && (
              <div>
                <h4 class="mb-2 font-medium text-gray-900 dark:text-white">Artefactos</h4>
                <div class="flex flex-wrap gap-2">
                  {study.artifacts.map(a => (
                    <a href={a.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700">{a.caption}</a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
