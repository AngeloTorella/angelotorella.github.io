---
import Section from '@components/ui/Section.astro';
import { getProfile } from '@lib/content';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { bio } = await getProfile(lang);
const points = ([1, 2, 3] as const).map((n) => ({
  title: t(`why.point${n}.title`),
  text: t(`why.point${n}.text`),
}));
---
<Section id="por-que-yo" tone="sunken" labelledby="why-title">
  <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
    <div>
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">{t('why.eyebrow')}</p>
      <h2 id="why-title" class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
        {t('why.title')}
      </h2>
      {bio && <p class="mt-6 text-lg leading-relaxed text-muted">{bio}</p>}
    </div>
    <ul class="space-y-4">
      {points.map((point, i) => (
        <li class="flex gap-5 rounded-2xl border border-line bg-surface p-6 shadow-card">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand font-display text-lg font-semibold text-on-brand" aria-hidden="true">{i + 1}</span>
          <div>
            <h3 class="text-lg font-semibold">{point.title}</h3>
            <p class="mt-1 text-muted">{point.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Section>
