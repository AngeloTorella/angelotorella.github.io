---
import Section from '@components/ui/Section.astro';

const steps = [
  { title: 'Conversación inicial', text: 'Sin costo, para entender el problema que quieres resolver y tu forma de trabajar.' },
  { title: 'Propuesta por escrito', text: 'Recibes el alcance, los tiempos y el presupuesto antes de empezar.' },
  { title: 'Desarrollo por etapas', text: 'Entregas parciales que puedes revisar, para ajustar el rumbo a tiempo.' },
  { title: 'Entrega y acompañamiento', text: 'Entrega con documentación y acompañamiento posterior para resolver dudas.' },
];
---
<Section id="proceso" labelledby="proceso-title">
  <div class="mb-12 max-w-2xl">
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">Cómo trabajo</p>
    <h2 id="proceso-title" class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
      Un proceso simple, sin sorpresas
    </h2>
  </div>
  <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {steps.map((step, i) => (
      <li class="relative border-t-2 border-brand pt-6">
        <span class="font-display text-4xl font-semibold text-brand">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
        <p class="mt-2 text-muted">{step.text}</p>
      </li>
    ))}
  </ol>
</Section>
