---
import Section from '@components/ui/Section.astro';

const steps = [
  { title: 'Conversación inicial', text: 'Me cuentas tu situación y tus objetivos. Sin compromiso y sin tecnicismos.' },
  { title: 'Propuesta clara', text: 'Recibes por escrito el alcance, los plazos y el precio antes de empezar.' },
  { title: 'Desarrollo por etapas', text: 'Te muestro avances de forma regular para que puedas corregir el rumbo a tiempo.' },
  { title: 'Entrega y acompañamiento', text: 'Te entrego todo documentado, te explico cómo usarlo y sigo disponible para dudas.' },
];
---
<Section id="proceso" labelledby="proceso-title">
  <div class="mb-12 max-w-2xl">
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">Cómo trabajo</p>
    <h2 id="proceso-title" class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
      Un proceso simple, sin sorpresas
    </h2>
  </div>
  <ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {steps.map((step, i) => (
      <li class="relative border-t-2 border-brand pt-6">
        <span class="font-display text-4xl font-semibold text-brand">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
        <p class="mt-2 text-muted">{step.text}</p>
      </li>
    ))}
  </ol>
</Section>
