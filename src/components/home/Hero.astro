---
import Button from '@components/ui/Button.astro';
import { getProfile, publicFileExists } from '@lib/content';

const { name, title, headline, tagline, avatarUrl } = await getProfile();
// Never render an avatar that is not actually in /public.
const showAvatar = Boolean(avatarUrl && publicFileExists(avatarUrl));
const audiences = ['Empresas', 'Profesionales independientes', 'Equipos y despachos'];
const commitments = [
  'Trato directo con quien desarrolla',
  'Alcance, plazos y precio por escrito',
  'Entregas por etapas que puedes revisar',
  'Código y documentación entregados',
];
---
<section class="relative overflow-hidden border-b border-line" aria-labelledby="hero-title">
  <div class="pointer-events-none absolute -right-32 -top-32 h-96 w-96 rounded-full bg-brand-soft blur-3xl" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-8 md:py-24 lg:grid-cols-[1.35fr_1fr] lg:gap-16">
    <div class="rise-in">
      <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3.5 py-1.5 text-sm font-medium text-muted">
        <span class="h-2 w-2 rounded-full bg-brand" aria-hidden="true"></span>
        {title}
      </p>
      <h1 id="hero-title" class="font-display text-4xl font-semibold leading-[1.08] tracking-tight sm:text-5xl lg:text-6xl">
        {headline ?? title}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">{tagline}</p>
      <div class="mt-9 flex flex-col gap-3 sm:flex-row">
        <Button href="/contacto" size="lg" arrow>Hablemos de tu proyecto</Button>
        <Button href="/#servicios" variant="secondary" size="lg">Ver servicios</Button>
      </div>
      <p class="mt-8 text-sm text-muted">
        <span class="font-medium text-ink">Trabajo con:</span>
        {audiences.join(' · ')}
      </p>
    </div>

    <aside class="rise-in-delay" aria-labelledby="commitments-title">
      <div class="rounded-3xl border border-line bg-surface p-8 shadow-lift">
        {showAvatar && <img src={avatarUrl} alt={name} width="72" height="72" class="mb-6 h-[72px] w-[72px] rounded-full object-cover" />}
        <h2 id="commitments-title" class="font-display text-2xl font-semibold">Así trabajo contigo</h2>
        <ul class="mt-6 space-y-4">
          {commitments.map(item => (
            <li class="flex items-start gap-3">
              <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7" /></svg>
              <span class="font-medium">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </aside>
  </div>
</section>
