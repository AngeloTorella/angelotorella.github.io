---
import ServiceCard from './ServiceCard.astro';
import { getServices } from '@lib/content';
const services = await getServices();
---
<section id="servicios" class="py-16 md:py-24 bg-white dark:bg-gray-950">
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-12 max-w-3xl mx-auto text-center">
      <h2 class="mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">Servicios</h2>
      <p class="text-lg text-gray-600 dark:text-gray-300">
        Desarrollo de software con foco en resultados claros, código mantenible y comunicación directa.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map(service => <ServiceCard service={service} />)}
    </div>
    <div class="mt-12 text-center">
      <a href="/contacto" class="inline-flex items-center gap-2 rounded-lg border-2 border-primary-600 bg-transparent px-8 py-3 text-base font-semibold text-primary-600 hover:bg-primary-50 dark:hover:bg-primary-900/20 transition-colors">
        Cuéntame tu proyecto
        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4-4 4m-6-8l4 4-4 4"/></svg>
      </a>
    </div>
  </div>
</section>
