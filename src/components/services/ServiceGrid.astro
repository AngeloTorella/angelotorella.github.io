---
import ServiceCard from './ServiceCard.astro';
import Section from '@components/ui/Section.astro';
import { getServices } from '@lib/content';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const services = await getServices(lang);
---
<Section id="servicios" labelledby="servicios-title">
  <div class="mb-12 max-w-2xl">
    <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-accent">{t('services.eyebrow')}</p>
    <h2 id="servicios-title" class="font-display text-3xl font-semibold leading-tight tracking-tight md:text-4xl">
      {t('services.title')}
    </h2>
    <p class="mt-4 text-lg text-muted">
      {t('services.intro')}
    </p>
  </div>
  <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {services.map((service, i) => <ServiceCard service={service} index={i} />)}
  </div>
</Section>
