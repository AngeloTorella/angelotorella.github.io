---
import type { CollectionEntry } from 'astro:content';
import { getServiceTech } from '@lib/content';

interface Props {
  service: CollectionEntry<'services'>;
  index: number;
}
const { service, index } = Astro.props;
const { title, tagline, icon, includes } = service.data;
const techStack = await getServiceTech(service);

const iconPaths: Record<string, string> = {
  database: 'M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4',
  code: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  cog: 'M12 6V4m0 16v-2m6-6h2M4 12h2m10.95-4.95 1.41-1.41M5.64 18.36l1.41-1.41m0-9.9L5.64 5.64m12.72 12.72-1.41-1.41M15 12a3 3 0 11-6 0 3 3 0 016 0z',
};
const fallbackPath = 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z';
const iconPath = (icon && iconPaths[icon]) || fallbackPath;
---
<article class="group relative flex h-full flex-col rounded-2xl border border-line bg-surface p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-brand/50 hover:shadow-lift focus-within:border-brand/50">
  <div class="mb-6 flex items-start justify-between">
    <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-soft text-brand">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
        <path d={iconPath} />
      </svg>
    </div>
    <span class="font-display text-2xl text-muted/60" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <h3 class="font-display text-2xl font-semibold leading-snug tracking-tight">
    <a href={`/services/${service.id}`} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-offset-4">{title}</a>
  </h3>
  <p class="mt-3 text-muted">{tagline}</p>

  {includes.length > 0 && (
    <ul class="mt-6 space-y-2 border-t border-line pt-6 text-sm">
      {includes.slice(0, 3).map(item => (
        <li class="flex gap-2.5">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7" /></svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}

  {techStack.length > 0 && (
    <div class="mt-5 flex flex-wrap gap-2">
      {techStack.slice(0, 4).map(tech => (
        <span class="rounded-full bg-brand-soft px-2.5 py-0.5 text-xs font-medium text-brand">{tech.data.name}</span>
      ))}
    </div>
  )}

  <span class="mt-auto inline-flex items-center gap-1.5 pt-7 text-sm font-semibold text-brand">
    Ver el servicio
    <span aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1">→</span>
  </span>
</article>
