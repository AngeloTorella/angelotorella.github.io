---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import ServiceGrid from '@components/services/ServiceGrid.astro';
import CaseStudiesAccordion from '@components/case-studies/CaseStudiesAccordion.astro';
import CTASection from '@components/layout/CTASection.astro';
import { getProfile, getCaseStudies, publicFileExists } from '@lib/content';

const [profile, allCaseStudies] = await Promise.all([getProfile(), getCaseStudies()]);
const { name, title, tagline, bio, email, linkedin, github, twitter, avatarUrl } = profile;
const caseStudies = allCaseStudies.slice(0, 3);
// Never render an avatar that is not actually in /public.
const showAvatar = Boolean(avatarUrl && publicFileExists(avatarUrl));
---
<BaseLayout title={`${name} — ${title}`} description={tagline}>
  <section class="relative overflow-hidden bg-gradient-to-b from-primary-50 to-white dark:from-gray-900 dark:to-gray-950">
    <Section class="pt-20 pb-16 md:pt-32 md:pb-24" padded={false}>
      <div class="mx-auto max-w-4xl px-4 text-center md:px-6">
        {showAvatar && (
          <div class="mb-6 flex justify-center">
            <img src={avatarUrl} alt={name} width="96" height="96" class="h-24 w-24 rounded-full border-4 border-primary-100 dark:border-primary-900" />
          </div>
        )}
        <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 dark:text-white md:text-5xl lg:text-6xl">{name}</h1>
        <p class="mb-6 text-xl text-gray-600 dark:text-gray-300 md:text-2xl">{title}</p>
        <p class="mb-8 max-w-2xl mx-auto text-lg text-gray-600 dark:text-gray-400">{tagline}</p>
        <div class="mb-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
          <a href="/contacto" class="w-full sm:w-auto rounded-lg bg-primary-600 px-8 py-3 text-base font-semibold text-white shadow-lg hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950 transition-colors">
            Agendar llamada
          </a>
          <a href="/cv" class="w-full sm:w-auto rounded-lg border-2 border-gray-300 bg-white px-8 py-3 text-base font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700 transition-colors">
            Ver CV
          </a>
        </div>
        <div class="flex items-center justify-center gap-6 text-sm text-gray-500 dark:text-gray-400">
          {linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-primary-600 dark:hover:text-primary-400" aria-label="LinkedIn"><svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>}
          {github && <a href={github} target="_blank" rel="noopener noreferrer" class="hover:text-primary-600 dark:hover:text-primary-400" aria-label="GitHub"><svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg></a>}
          {twitter && <a href={twitter} target="_blank" rel="noopener noreferrer" class="hover:text-primary-600 dark:hover:text-primary-400" aria-label="Twitter"><svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>}
          {email && <a href={`mailto:${email}`} class="hover:text-primary-600 dark:hover:text-primary-400" aria-label="Email"><svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg></a>}
        </div>
      </div>
    </Section>
    <div class="absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-t from-white dark:from-gray-950 to-transparent" aria-hidden="true"></div>
  </section>

  {bio && (
    <Section>
      <div class="mx-auto max-w-3xl">
        <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">Sobre mí</h2>
        <p class="text-lg text-gray-600 dark:text-gray-300">{bio}</p>
      </div>
    </Section>
  )}

  <ServiceGrid />

  {caseStudies.length > 0 && (
    <CaseStudiesAccordion caseStudies={caseStudies} title="Proyectos recientes" />
  )}

  <CTASection
    title="¿Hablamos de tu proyecto?"
    description="Cuéntame qué necesitas y te respondo con los próximos pasos."
    ctaText="Contactar"
    ctaHref="/contacto"
  />
</BaseLayout>
