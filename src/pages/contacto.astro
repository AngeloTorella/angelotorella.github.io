---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import { getProfile, getServices } from '@lib/content';

const [{ name, email, linkedin, calendarUrl }, services] = await Promise.all([getProfile(), getServices()]);
// Formspree-compatible endpoint. When unset, the page falls back to a mailto link.
const formEndpoint = import.meta.env.PUBLIC_FORM_ENDPOINT?.trim();
const mailto = `mailto:${email}?subject=${encodeURIComponent('Consulta desde la web')}`;

const inputClass = 'w-full rounded-lg border border-gray-300 bg-white px-4 py-2 text-gray-900 focus:border-primary-500 focus:outline-none focus:ring-2 focus:ring-primary-500/20 dark:border-gray-600 dark:bg-gray-800 dark:text-white';
const labelClass = 'block mb-1 text-sm font-medium text-gray-700 dark:text-gray-300';
const cardClass = 'rounded-xl border border-gray-200 bg-gray-50 p-6 hover:border-primary-300 dark:border-gray-700 dark:bg-gray-900 dark:hover:border-primary-700';
---
<BaseLayout title={`Contacto — ${name}`} description="Cuéntame tu proyecto y agendamos una llamada sin compromiso">
  <Section class="pt-12">
    <div class="mx-auto max-w-3xl">
      <header class="mb-12 text-center">
        <h1 class="mb-4 text-3xl font-bold tracking-tight text-gray-900 dark:text-white md:text-4xl">Hablemos</h1>
        <p class="text-lg text-gray-600 dark:text-gray-300">
          Cuéntame brevemente qué necesitas y te respondo para agendar una llamada.
          Si no es buen fit, te lo diré con sinceridad.
        </p>
      </header>

      {formEndpoint ? (
        <form id="contact-form" class="relative overflow-hidden rounded-xl border border-gray-200 bg-white p-8 shadow-sm dark:border-gray-700 dark:bg-gray-900" action={formEndpoint} method="POST">
          <!-- Honeypot: real users leave it empty; Formspree discards submissions that fill it. -->
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="_gotcha">No rellenar</label>
            <input type="text" id="_gotcha" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="mb-6">
            <label for="name" class={labelClass}>Nombre *</label>
            <input type="text" id="name" name="name" required autocomplete="name" class={inputClass} placeholder="Tu nombre" />
          </div>

          <div class="mb-6">
            <label for="email" class={labelClass}>Email *</label>
            <input type="email" id="email" name="email" required autocomplete="email" class={inputClass} placeholder="tu@empresa.com" />
          </div>

          <div class="mb-6">
            <label for="company" class={labelClass}>Empresa</label>
            <input type="text" id="company" name="company" autocomplete="organization" class={inputClass} placeholder="Nombre de tu empresa" />
          </div>

          <div class="mb-6">
            <label for="service" class={labelClass}>Servicio</label>
            <select id="service" name="service" class={inputClass}>
              <option value="">Sin especificar</option>
              {services.map(service => <option value={service.id}>{service.data.title}</option>)}
            </select>
          </div>

          <div class="mb-8">
            <label for="message" class={labelClass}>¿En qué te puedo ayudar? *</label>
            <textarea id="message" name="message" required rows="4" class={inputClass} placeholder="Describe brevemente tu reto, objetivos, plazos..."></textarea>
          </div>

          <button type="submit" class="w-full rounded-lg bg-primary-600 px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            Enviar mensaje
          </button>
        </form>
      ) : (
        <div class="rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm dark:border-gray-700 dark:bg-gray-900">
          <p class="mb-6 text-gray-600 dark:text-gray-300">Escríbeme directamente por email:</p>
          <a href={mailto} class="inline-flex rounded-lg bg-primary-600 px-8 py-3 text-base font-semibold text-white transition-colors hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-900">
            {email}
          </a>
        </div>
      )}

      <div class="mt-12 grid gap-6 text-center md:grid-cols-3">
        <a href={mailto} class={cardClass}>
          <div class="mb-2 text-3xl">✉️</div>
          <h3 class="mb-1 font-medium text-gray-900 dark:text-white">Email directo</h3>
          <p class="break-all text-sm text-gray-600 dark:text-gray-400">{email}</p>
        </a>
        {linkedin && (
          <a href={linkedin} target="_blank" rel="noopener" class={cardClass}>
            <div class="mb-2 text-3xl">💼</div>
            <h3 class="mb-1 font-medium text-gray-900 dark:text-white">LinkedIn</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Mensaje directo</p>
          </a>
        )}
        {calendarUrl && (
          <a href={calendarUrl} target="_blank" rel="noopener" class={cardClass}>
            <div class="mb-2 text-3xl">📅</div>
            <h3 class="mb-1 font-medium text-gray-900 dark:text-white">Agenda</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">Elige horario directo</p>
          </a>
        )}
      </div>
    </div>
  </Section>

  {formEndpoint && (
    <script is:inline>
      // Pre-select the service passed as ?service=<id> (e.g. from a service page CTA).
      (function () {
        var id = new URLSearchParams(location.search).get('service');
        var select = document.getElementById('service');
        if (id && select && select.querySelector('option[value="' + CSS.escape(id) + '"]')) select.value = id;
      })();
    </script>
  )}
</BaseLayout>
