---
import BaseLayout from '@layouts/BaseLayout.astro';
import CTASection from '@components/layout/CTASection.astro';
import { getProfile, getExperienceForCv, getTechStackByCategory, formatMonth } from '@lib/content';

const [profile, experience, skillGroups] = await Promise.all([
  getProfile(),
  getExperienceForCv(),
  getTechStackByCategory(),
]);
const { name, title, bio, email, linkedin, github, location, education, languages, certifications } = profile;

/** Human-readable span for an entry; empty when nothing is known. */
function period(exp: { startDate?: string; endDate?: string; duration?: string }) {
  if (exp.startDate) return `${formatMonth(exp.startDate)} – ${exp.endDate ? formatMonth(exp.endDate) : 'Actualidad'}`;
  return exp.duration ?? '';
}

/** Splits "Institution — Program" so the institution can lead the entry. */
function splitEducation(item: string) {
  const [org, ...rest] = item.split(' — ');
  return { org, detail: rest.join(' — ') };
}
---
<BaseLayout title={`CV | ${name}`} description={`Trayectoria profesional de ${name}, ${title}.`}>
  <div class="cv-wrap mx-auto max-w-[760px] px-4 pb-16 pt-10 sm:px-6">
    <div class="no-print mb-4 flex justify-end">
      <button
        type="button"
        id="cv-print"
        class="rounded-lg border border-line bg-surface px-4 py-2 text-sm font-medium text-ink transition-colors hover:border-brand hover:text-brand"
      >
        Imprimir
      </button>
    </div>

    <article class="cv-sheet" aria-label={`Currículum de ${name}`}>
      <header class="cv-header">
        <h1 class="cv-name">{name}</h1>
        <p class="cv-contact">
          {[
            location && <span>{location}</span>,
            <a href={`mailto:${email}`}>{email}</a>,
            linkedin && <a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>,
            github && <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>,
          ].filter(Boolean).map((node, i) => (
            <>{i > 0 && <span class="cv-sep" aria-hidden="true"> · </span>}{node}</>
          ))}
        </p>
      </header>

      {bio && (
        <section class="cv-section" aria-labelledby="cv-perfil">
          <h2 id="cv-perfil">Perfil</h2>
          <p class="cv-text">{bio}</p>
        </section>
      )}

      {experience.length > 0 && (
        <section class="cv-section" aria-labelledby="cv-exp">
          <h2 id="cv-exp">Experiencia</h2>
          {experience.map(({ data: exp }) => {
            const when = period(exp);
            return (
              <div class="cv-entry">
                <div class="cv-row">
                  <strong>{exp.company ?? exp.role}</strong>
                  {when && <span>{when}</span>}
                </div>
                {(exp.company || exp.location) && (
                  <div class="cv-row">
                    <em>{exp.company ? exp.role : ''}</em>
                    {exp.location && <span>{exp.location}</span>}
                  </div>
                )}
                {exp.description && <p class="cv-text">{exp.description}</p>}
                {exp.highlights.length > 0 && (
                  <ul class="cv-bullets">{exp.highlights.map(h => <li>{h}</li>)}</ul>
                )}
              </div>
            );
          })}
        </section>
      )}

      {education.length > 0 && (
        <section class="cv-section" aria-labelledby="cv-edu">
          <h2 id="cv-edu">Formación</h2>
          {education.map(item => {
            const { org, detail } = splitEducation(item);
            return (
              <div class="cv-entry">
                <div class="cv-row"><strong>{org}</strong></div>
                {detail && <div class="cv-row"><em>{detail}</em></div>}
              </div>
            );
          })}
        </section>
      )}

      {certifications.length > 0 && (
        <section class="cv-section" aria-labelledby="cv-certs">
          <h2 id="cv-certs">Certificaciones</h2>
          <ul class="cv-certs">
            {certifications.map(c => (
              <li>
                <span>
                  <strong>{c.name}</strong>
                  {c.issuer && <> — {c.issuer}</>}
                </span>
                {c.year && <span class="cv-year">{c.year}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}

      {skillGroups.length > 0 && (
        <section class="cv-section" aria-labelledby="cv-skills">
          <h2 id="cv-skills">Habilidades</h2>
          {skillGroups.map(group => (
            <p class="cv-text"><strong>{group.category}:</strong> {group.skills.join(', ')}</p>
          ))}
        </section>
      )}

      {languages.length > 0 && (
        <section class="cv-section" aria-labelledby="cv-lang">
          <h2 id="cv-lang">Idiomas</h2>
          <p class="cv-text">{languages.map(l => `${l.name} (${l.level})`).join(' · ')}</p>
        </section>
      )}
    </article>
  </div>

  <div class="no-print"><CTASection /></div>
</BaseLayout>

<script>
  document.getElementById('cv-print')?.addEventListener('click', () => window.print());
</script>

<style is:global>
  /* The sheet is a document: it stays light and dark-ink in every color scheme. */
  .cv-sheet {
    background: #fff;
    color: #111;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    line-height: 1.5;
    padding: 2.5rem 1.5rem;
    border: 1px solid rgb(var(--line));
    border-radius: 4px;
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.08);
  }
  @media (min-width: 640px) {
    .cv-sheet {
      padding: 3rem 3.25rem;
    }
  }
  .cv-sheet a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cv-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .cv-name {
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.15;
  }
  .cv-contact {
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
  .cv-section {
    margin-top: 1.25rem;
  }
  .cv-section h2 {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-bottom: 1px solid #111;
    padding-bottom: 0.2rem;
    margin-bottom: 0.6rem;
  }
  .cv-entry {
    margin-bottom: 0.7rem;
    break-inside: avoid;
  }
  .cv-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .cv-row > span {
    white-space: nowrap;
  }
  .cv-text {
    margin-top: 0.2rem;
  }
  .cv-bullets {
    list-style: disc;
    padding-left: 1.25rem;
    margin-top: 0.25rem;
  }
  .cv-certs {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 2rem;
    row-gap: 0.35rem;
    font-size: 0.875rem;
  }
  @media (min-width: 640px) {
    .cv-certs {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cv-certs li {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    break-inside: avoid;
  }
  .cv-year {
    white-space: nowrap;
  }

  @media print {
    @page {
      margin: 15mm;
    }
    body > :not(main),
    .no-print {
      display: none !important;
    }
    html,
    body {
      background: #fff !important;
    }
    .cv-wrap {
      max-width: none;
      padding: 0;
    }
    .cv-sheet {
      border: 0;
      border-radius: 0;
      box-shadow: none;
      padding: 0;
      color: #000;
      font-size: 10.5pt;
    }
    .cv-section h2,
    .cv-entry {
      break-inside: avoid;
    }
    .cv-section h2 {
      break-after: avoid;
    }
  }
</style>
