---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import {
  getProfile,
  getExperienceForCv,
  getTechStackByCategory,
  publicFileExists,
  formatMonth,
} from '@lib/content';

const CV_PDF_PATH = '/cv/angelo-torella-cv.pdf';

const [profile, experience, skillGroups] = await Promise.all([
  getProfile(),
  getExperienceForCv(),
  getTechStackByCategory(),
]);
const { name, title, tagline, bio, email, linkedin, github, location, education, languages } = profile;
// The download link only renders when the PDF has been placed in /public.
const hasPdf = publicFileExists(CV_PDF_PATH);

const typeLabels: Record<string, string> = {
  'full-time': 'Jornada completa',
  contract: 'Contrato',
  freelance: 'Freelance',
  'side-project': 'Proyecto personal',
};
---
<BaseLayout title={`CV — ${name}`} description={`Curriculum vitae de ${name}, ${title}`}>
  <Section class="pt-12 pb-8">
    <div class="mx-auto max-w-4xl">
      <header class="mb-12 text-center">
        <h1 class="mb-2 text-3xl font-bold text-gray-900 dark:text-white md:text-4xl">{name}</h1>
        <p class="mb-2 text-xl text-primary-600 dark:text-primary-400">{title}</p>
        <p class="mb-6 text-lg text-gray-600 dark:text-gray-400">{tagline}</p>
        <div class="flex flex-wrap items-center justify-center gap-4 text-sm text-gray-500 dark:text-gray-400">
          {location && <span>📍 {location}</span>}
          {email && <a href={`mailto:${email}`} class="hover:text-primary-600 dark:hover:text-primary-400">✉️ {email}</a>}
          {linkedin && <a href={linkedin} target="_blank" rel="noopener" class="hover:text-primary-600 dark:hover:text-primary-400">LinkedIn</a>}
          {github && <a href={github} target="_blank" rel="noopener" class="hover:text-primary-600 dark:hover:text-primary-400">GitHub</a>}
        </div>
        {hasPdf && (
          <a href={CV_PDF_PATH} download class="mt-8 inline-flex items-center gap-2 rounded-lg bg-primary-600 px-8 py-3 text-base font-semibold text-white shadow-lg hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:focus:ring-offset-gray-950 transition-colors">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
            Descargar CV (PDF)
          </a>
        )}
      </header>

      <div class="space-y-12">
        {bio && (
          <section>
            <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">Resumen</h2>
            <p class="text-gray-600 dark:text-gray-300">{bio}</p>
          </section>
        )}

        {experience.length > 0 && (
          <section>
            <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-white">Experiencia</h2>
            <div class="space-y-8">
              {experience.map(({ data: exp }) => (
                <article class="border-l-2 border-gray-200 pl-6 dark:border-gray-700">
                  <div class="flex flex-col gap-1 md:flex-row md:items-baseline md:justify-between">
                    <div>
                      <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{exp.role}</h3>
                      <p class="text-primary-600 dark:text-primary-400">{exp.company}</p>
                    </div>
                    <p class="text-sm text-gray-500 dark:text-gray-400 md:whitespace-nowrap">
                      {formatMonth(exp.startDate)} – {exp.endDate ? formatMonth(exp.endDate) : 'Actualidad'}
                    </p>
                  </div>
                  <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                    {[exp.location, typeLabels[exp.type]].filter(Boolean).join(' · ')}
                  </p>
                  {exp.description && <p class="mt-3 text-gray-600 dark:text-gray-300">{exp.description}</p>}
                  {exp.highlights.length > 0 && (
                    <ul class="mt-3 space-y-2">
                      {exp.highlights.map(h => (
                        <li class="flex gap-2 text-gray-600 dark:text-gray-300">
                          <span class="text-primary-500">→</span> {h}
                        </li>
                      ))}
                    </ul>
                  )}
                  {exp.stack.length > 0 && (
                    <div class="mt-3 flex flex-wrap gap-2">
                      {exp.stack.map(tech => (
                        <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">{tech}</span>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>
        )}

        {skillGroups.length > 0 && (
          <section>
            <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-white">Competencias técnicas</h2>
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {skillGroups.map(group => (
                <div class="rounded-xl border border-gray-200 bg-white p-5 dark:border-gray-700 dark:bg-gray-900">
                  <h3 class="mb-3 font-medium text-gray-900 dark:text-white">{group.category}</h3>
                  <div class="flex flex-wrap gap-2">
                    {group.skills.map(s => (
                      <span class="rounded-full bg-primary-50 px-2.5 py-0.5 text-xs font-medium text-primary-700 dark:bg-primary-900/30 dark:text-primary-300">{s}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </section>
        )}

        {(education.length > 0 || languages.length > 0) && (
          <section>
            <h2 class="mb-6 text-2xl font-bold text-gray-900 dark:text-white">Educación e idiomas</h2>
            <div class="grid gap-6 md:grid-cols-2">
              {education.length > 0 && (
                <div>
                  <h3 class="mb-3 font-medium text-gray-900 dark:text-white">Formación</h3>
                  <ul class="space-y-2">
                    {education.map(item => <li class="text-gray-600 dark:text-gray-300">{item}</li>)}
                  </ul>
                </div>
              )}
              {languages.length > 0 && (
                <div>
                  <h3 class="mb-3 font-medium text-gray-900 dark:text-white">Idiomas</h3>
                  <ul class="space-y-2">
                    {languages.map(lang => (
                      <li class="flex justify-between gap-4 text-gray-600 dark:text-gray-300"><span>{lang.name}</span><span class="font-medium text-primary-600 dark:text-primary-400">{lang.level}</span></li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </section>
        )}
      </div>
    </div>
  </Section>
</BaseLayout>
